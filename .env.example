# Use Neon's POOLED connection string here (the one with "-pooler" in the host).
# This matters: with 10+ staff hitting the API at once, the pooled endpoint
# (pgbouncer) avoids exhausting Neon's direct connection limit.
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname


# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# Comma-separated list of origins allowed to call this API (your Vercel frontend URL)
CORS_ORIGINS=http://localhost:5173
